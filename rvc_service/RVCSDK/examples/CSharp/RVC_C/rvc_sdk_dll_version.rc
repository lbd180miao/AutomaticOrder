#include <windows.h>

#include "rvc_sdk_dll_version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     MYPROJECT_VERSION_MAJOR, MYPROJECT_VERSION_MINOR, MYPROJECT_VERSION_PATCH, MYPROJECT_VERSION_TWEAK
PRODUCTVERSION  MYPROJECT_VERSION_MAJOR, MYPROJECT_VERSION_MINOR, MYPROJECT_VERSION_PATCH, MYPROJECT_VERSION_TWEAK

FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", MYPROJECT_COMPANY_NAME
            VALUE "FileDescription", MYPROJECT_FILE_DESCRIPTION
            VALUE "FileVersion", MYPROJECT_FILE_VERSION
            VALUE "InternalName", MYPROJECT_INTERNAL_NAME
            VALUE "LegalCopyright", MYPROJECT_LEGAL_COPYRIGHT
            VALUE "OriginalFilename", MYPROJECT_ORIGINAL_FILENAME
            VALUE "ProductName", MYPROJECT_PRODUCT_NAME
            VALUE "ProductVersion", MYPROJECT_PRODUCT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
